{
  "config": {
    "abort": {
      "single_instance_allowed": "[%key:common::config_flow::abort::single_instance_allowed%]",
      "unsupported_manual_setup": "Configuration is only supported via auto-discovery. Check HeishaMon is connected to your MQTT server and sending messages. Also check that Home Assistant is connected to the MQTT server. The integration will then be discovered automatically."
    },
    "step": {
      "confirm": {
        "description": "All configured!"
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Entities and installation",
        "description": "The heat pump reports which optional parts are installed (DHW tank, buffer tank, solar, bivalent, SG ready, optional PCB, cooling). Entities belonging to such a part are disabled by default.",
        "data": {
          "entity_management": "Entities of optional parts",
          "settings_guard": "Refuse settings that have no effect while the setting they depend on is off",
          "hide_without_effect": "Hide settings that have no effect while the setting they depend on is off",
          "api_key": "HeishaMon API key",
          "use_https": "Use HTTPS",
          "cert_fingerprint": "Certificate fingerprint (SHA-256)"
        },
        "data_description": {
          "api_key": "Only needed if a password is set on HeishaMon (security page). 32 hexadecimal characters; leave empty without login.",
          "use_https": "Talk to HeishaMon over HTTPS (reboot, firmware upload). Requires HTTPS to be enabled on HeishaMon. There is no fallback to HTTP.",
          "cert_fingerprint": "Only used with HTTPS. Copy the SHA-256 fingerprint shown on the access page of HeishaMon (64 hexadecimal characters, colons and spaces are allowed); this is needed for the self-signed certificate of HeishaMon. Leave empty only if you uploaded a certificate that is trusted by the system CAs and valid for the IP address of the board: it is then verified like any web site."
        }
      }
    },
    "error": {
      "invalid_api_key": "The API key must be empty or consist of exactly 32 hexadecimal characters.",
      "invalid_cert_fingerprint": "The certificate fingerprint must be empty or a SHA-256 fingerprint of exactly 64 hexadecimal characters (colons and spaces are allowed)."
    }
  },
  "selector": {
    "entity_management": {
      "options": {
        "enable_only": "Enable them once the part is reported as installed",
        "unavailable": "Also show them as unavailable while the part is not installed",
        "disable": "Also disable them while the part is not installed"
      }
    }
  },
  "issues": {
    "heat_pump_fault": {
      "title": "Heat pump fault {code}",
      "description": "The heat pump reports fault **{code}**: {description}.\n\nThe heat pump may stay stopped until the fault is reset. Remove the cause first, then press the button \"Reset fault code\" of the heat pump. This message disappears when the heat pump reports no fault anymore."
    },
    "command_failed": {
      "title": "Heat pump did not take over a command",
      "description": "`{entity}` was set to **{expected}**, but after {attempts} attempts the heat pump still reports **{received}**.\n\nCheck that HeishaMon is online and not in listen-only mode, and that the heat pump accepts this value in its current settings. This message disappears when the next command of this entity is taken over."
    }
  },
