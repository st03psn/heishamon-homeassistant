  "exceptions": {
    "setting_needs_parent": {
      "message": "{command} has no effect now: {parent} is {actual}, it would have to be {needed}. Change that setting first, or switch off the check in the options of the integration."
    },
    "reboot_unauthorized": {
      "message": "HeishaMon rejected the request because a web login is active. Enter the API key of HeishaMon (created on its security page) in the options of the integration."
    },
    "firmware_upload_connection_failed": {
      "message": "Could not upload firmware version {version} to HeishaMon at {host}: {error}. The network or a restart of the board may have interrupted the upload. If a password is set on HeishaMon, a missing or wrong API key has the same effect: check the API key in the options of the integration."
    },
    "certificate_fingerprint_mismatch": {
      "message": "The certificate of HeishaMon at {host} does not match the fingerprint in the options of the integration. The certificate has probably changed (regenerated or uploaded on HeishaMon). Copy the new SHA-256 fingerprint from the access page of HeishaMon into the options of the integration."
    },
    "certificate_verification_failed": {
      "message": "The certificate of HeishaMon at {host} could not be verified against the system CAs. Enter the SHA-256 fingerprint shown on the access page of HeishaMon in the options of the integration, or upload a trusted certificate that is valid for this address to HeishaMon."
    }
  }
}
