  "options": {
    "step": {
      "init": {
        "title": "Entitäten und Anlage",
        "description": "Die Wärmepumpe meldet, welche optionalen Anlagenteile vorhanden sind (Warmwasserspeicher, Pufferspeicher, Solar, bivalent, SG ready, optionale Platine, Kühlung). Entitäten dieser Anlagenteile sind standardmäßig deaktiviert.",
        "data": {
          "entity_management": "Entitäten optionaler Anlagenteile",
          "settings_guard": "Einstellungen ablehnen, die wirkungslos sind, solange die Einstellung aus ist, von der sie abhängen",
          "hide_without_effect": "Einstellungen ausblenden, die wirkungslos sind, solange die Einstellung aus ist, von der sie abhängen"
        }
      }
    }
  },
  "selector": {
    "entity_management": {
      "options": {
        "enable_only": "Aktivieren, sobald das Anlagenteil als vorhanden gemeldet wird",
        "unavailable": "Zusätzlich als nicht verfügbar anzeigen, solange das Anlagenteil fehlt",
        "disable": "Zusätzlich deaktivieren, solange das Anlagenteil fehlt"
      }
    }
  },
  "issues": {
    "heat_pump_fault": {
      "title": "Störung der Wärmepumpe {code}",
      "description": "Die Wärmepumpe meldet die Störung **{code}**: {description}.\n\nDie Wärmepumpe kann stehen bleiben, bis die Störung zurückgesetzt ist. Erst die Ursache beheben, dann bei der Wärmepumpe den Knopf „Reset fault code“ drücken. Diese Meldung verschwindet, sobald die Wärmepumpe keine Störung mehr meldet."
    },
    "command_failed": {
      "title": "Wärmepumpe hat einen Befehl nicht übernommen",
      "description": "`{entity}` wurde auf **{expected}** gesetzt, nach {attempts} Versuchen meldet die Wärmepumpe aber weiterhin **{received}**.\n\nPrüfe, ob HeishaMon online und nicht im Nur-Lesen-Modus ist und ob die Wärmepumpe diesen Wert bei ihren aktuellen Einstellungen annimmt. Diese Meldung verschwindet, sobald der nächste Befehl dieser Entität übernommen wurde."
    }
  },
